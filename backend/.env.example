# --- service ---------------------------------------------------------------
PREVENTAI_ENVIRONMENT=dev
PREVENTAI_CORS_ORIGINS=["http://localhost:5173"]

# --- optional LLM enrichment ----------------------------------------------
# Leave as "none" and the pipeline runs fully on its deterministic rules.
PREVENTAI_LLM_PROVIDER=none
# PREVENTAI_LLM_PROVIDER=anthropic
# PREVENTAI_LLM_MODEL=claude-sonnet-4-5
# PREVENTAI_ANTHROPIC_API_KEY=sk-ant-...

# --- optional Cognito auth -------------------------------------------------
# Unset = open dev mode. Set = every request needs a valid Cognito token.
# PREVENTAI_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# PREVENTAI_COGNITO_REGION=us-east-1
# PREVENTAI_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
